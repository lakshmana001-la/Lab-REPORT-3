    "name": "Lab 03 - REST API, Query Parameters, Validation & Debugging",
    "description": "Comprehensive Postman test collection for Backend Development Fundamentals Lab 3.\nCovers all CRUD endpoints, query parameters (search_q, order_by, order, limit, offset), price range filtering (min_price, max_price), body validation (400), not found handling (404), and successful response codes (200, 201).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. GET All Books (Default)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:3000/books/",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["books", ""]
        },
        "description": "Fetch all books using default query parameters."
      }
    },
    {
      "name": "2. GET Search Books by Title (search_q)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:3000/books/?search_q=The",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["books", ""],
          "query": [
            {
              "key": "search_q",
              "value": "The"
            }
          ]
        },
        "description": "Searches books whose title contains 'The' using SQL LIKE operator."
      }
    },
    {
      "name": "3. GET Sort Books by Price DESC (order_by & order)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:3000/books/?order_by=price&order=DESC",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["books", ""],
          "query": [
            {
              "key": "order_by",
              "value": "price"
            },
            {
              "key": "order",
              "value": "DESC"
            }
          ]
        },
        "description": "Sorts books by price in descending order."
      }
    },
    {
      "name": "4. GET Filter by Price Range (min_price & max_price)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:3000/books/?min_price=300&max_price=500",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["books", ""],
          "query": [
            {
              "key": "min_price",
              "value": "300"
            },
            {
              "key": "max_price",
              "value": "500"
            }
          ]
        },
        "description": "Filters books with price between 300 and 500 using SQL BETWEEN."
      }
    },
    {
      "name": "5. GET Pagination (limit & offset)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:3000/books/?limit=3&offset=0",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["books", ""],
          "query": [
            {
              "key": "limit",
              "value": "3"
            },
            {
              "key": "offset",
              "value": "0"
            }
          ]
        },
        "description": "Returns first 3 books using LIMIT and OFFSET."
      }
    },
    {
